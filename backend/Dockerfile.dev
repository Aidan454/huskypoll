# HuskyPoll backend for local development (used by compose.yml at the repo root).
# compose mounts backend/ over /code, so code edits reload instantly.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HUSKYPOLL_DB=/data/huskypoll.db \
    HUSKYPOLL_MEDIA_DIR=/data/media

WORKDIR /code
COPY requirements.txt .
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY . .
RUN mkdir -p /data

EXPOSE 8000

# 1. bring the database up to date (creates it on first run)
# 2. start the API on 0.0.0.0 so it's reachable from outside the container,
#    with --reload so saving a .py file restarts it
CMD ["sh", "-c", "python -m alembic upgrade head && exec python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]
