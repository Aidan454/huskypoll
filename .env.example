# HuskyPoll environment variables.
#
# Copy this file and fill in real values:
#   cp .env.example .env

# --- Backend ------------------------------------------------------------------
# API lives at SITE_URL/api.
SITE_URL=http://localhost:8000
# Allow the frontend to call the API (CORS).
FRONTEND_URL=http://localhost:5173
# Dev-only login (POST /api/auth/dev-login). NEVER in production.
DEV_LOGIN=1
# SQLite database file + folder for uploaded images (kept in backend/data on the host).
DB=/data/huskypoll.db
MEDIA_DIR=/data/media
# Signs login cookies. MUST be a real secret in production; fixed here so logins
# survive reloads during development.
SECRET_KEY=dev-only-not-a-secret
# Code reload works with Windows/Mac file mounts.
WATCHFILES_FORCE_POLLING=true

# --- Frontend -----------------------------------------------------------------
# Where the frontend's code should send API calls (available as import.meta.env.VITE_API_BASE).
VITE_API_BASE=http://localhost:8000/api
