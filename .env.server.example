# Settings for compose.server.yml. On the server:
#   cp .env.server.example .env
# then fill in the values. .env is not committed.

# The address people type. CAS sends people back here after they sign in.
HUSKYPOLL_SITE_URL=http://huskypoll.cse.uconn.edu

# Signs login cookies. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HUSKYPOLL_SECRET_KEY=

# NetIDs made admins / instructors when they log in (comma-separated, optional).
# You can also use: docker compose -f compose.server.yml exec huskypoll python -m app.database set-role NETID admin
HUSKYPOLL_ADMIN_NETIDS=
HUSKYPOLL_INSTRUCTOR_NETIDS=

# Port on the server (80 = no port in the address).
HUSKYPOLL_PORT=80

# Set to 1 once the site is served over https://
HUSKYPOLL_SECURE_COOKIES=0
